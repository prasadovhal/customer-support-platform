# App
APP_NAME=Customer Support AI Platform
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Database (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/customer_support

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1
REDIS_RESULT_BACKEND=redis://localhost:6379/2

# JWT (required - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_SERVICE_NAME=customer-support-api

# Webhooks
WEBHOOK_SECRET=your-webhook-secret-here

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
