# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Customer Support AI Platform
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ── Database ───────────────────────────────────────────────────────────────────
# Local development (direct):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_support
# Docker Compose (uses service name "db"):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/customer_support

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379/...
# Docker: redis://redis:6379/...
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/1
REDIS_RESULT_BACKEND=redis://redis:6379/2

# ── JWT (required — generate with: openssl rand -hex 32) ──────────────────────
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_AGENT_TOKEN_EXPIRE_MINUTES=60

# ── LLM ────────────────────────────────────────────────────────────────────────
# Docker with --profile llm: http://ollama:11434
# Local Ollama:              http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_ENABLED=false
# Docker with --profile observability: http://jaeger:14268/api/traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces
OTEL_SERVICE_NAME=customer-support-api

# ── Policy & Approvals ────────────────────────────────────────────────────────
APPROVAL_SLA_HOURS=4

# ── Webhooks ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
